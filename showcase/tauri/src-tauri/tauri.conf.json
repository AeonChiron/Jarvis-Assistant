{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis Assistant",
  "version": "0.1.45",
  "identifier": "com.kenkai.roamies",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/roamies-node"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0RERCM0MyMjVCOUI4QjcKUldTM3VMa2x3clBkcEdGUmVXWUhLWnRpZ2dySjJ6ZE9SQUNOOXJoYk5ndGpxWkdqdXpJeWl3V04K",
      "endpoints": [
        "https://github.com/AeonChiron/Roamies/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
